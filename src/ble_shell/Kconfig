config ZMK_BLE_SHELL
    bool "ZMK BLE Shell GATT service"
    depends on BT
    depends on SHELL
    select SHELL_BACKEND_DUMMY
    default y
    help
      Exposes a custom GATT service (UUID c901c4e9-...) with a single
      NOTIFY+WRITE_WITHOUT_RESP characteristic.  Written payloads are
      executed as Zephyr shell commands and the output is relayed back
      via BLE notifications.  While the client has notifications enabled,
      ZMK log output is also forwarded through the same channel.

if ZMK_BLE_SHELL

config ZMK_BLE_SHELL_TX_BUF_SIZE
    int "TX ring-buffer size (bytes)"
    default 2048

config SHELL_BACKEND_DUMMY_BUF_SIZE
    default 2048 if ZMK_BLE_SHELL

config ZMK_BLE_SHELL_CMD_BUF_SIZE
    int "Maximum shell command length (bytes, including NUL)"
    default 256

config ZMK_BLE_SHELL_LOG_BUF_SIZE
    int "Log-formatting scratch buffer size (bytes)"
    default 256

config ZMK_BLE_SHELL_PROMPT_EN
    bool "Send prompt after connect and each command"
    default y

config ZMK_BLE_SHELL_PROMPT
    string "BLE shell prompt string"
    depends on ZMK_BLE_SHELL_PROMPT_EN
    default SHELL_PROMPT_UART

endif # ZMK_BLE_SHELL
